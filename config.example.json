{
  "ftp": {
    "host": "ftp.example.com",
    "port": 21,
    "username": "your_user",
    "password_env": "FTP_PASSWORD",
    "use_tls": false,
    "passive": true,
    "timeout": 60
  },
  "sync": {
    "local_root": "C:/URL/SAMPLE/AI",
    "remote_root": "public_html",
    "debounce_seconds": 1.5,
    "max_sync_directory_depth": -1,
    "v2_git_ai_prompt": false,
    "v2_git_github_push": false,
    "v2_prompt_cooldown_seconds": 90,
    "v3_reverse_local": "",
    "v3_reverse_remote_override": "",
    "multi_deploy_mode": "off",
    "deploy_targets": [],
    "backup_remote_previous": true,
    "recursive": true,
    "use_anchor_sync": true,
    "anchor_auto_match": true,
    "anchor_folder_name": "",
    "max_anchor_search_depth": 3,
    "exclude_names": [".git", "__pycache__", ".venv", "node_modules", ".idea"],
    "exclude_extensions": [".tmp", ".swp", ".lock"]
  },
  "ai": {
    "openai_api_key": "",
    "openai_base_url": "https://api.openai.com/v1",
    "openai_model": "gpt-4o-mini"
  }
